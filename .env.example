# Copy to .env. Never commit .env or put these values in VITE_* variables.
# Use the SAME origin in your browser and OAuth dashboards.
APP_URL=http://127.0.0.1:4173

# Verified sender/domain in Resend. Enables registration + six-digit email codes.
RESEND_API_KEY=
MAIL_FROM=

# Google OAuth Client -> Web application
# Redirect: http://127.0.0.1:4173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App
# Callback: http://127.0.0.1:4173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Platform moderators. Community owners appoint their own validators in the UI.
MODERATOR_EMAILS=
