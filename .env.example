# Copy to .env. Never commit .env or put these values in VITE_* variables.
# Use the SAME origin in your browser and OAuth dashboards.
APP_URL=http://127.0.0.1:4173

# Email provider: brevo or resend. MAIL_FROM must be a verified sender.
MAIL_PROVIDER=resend
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=

# Google OAuth Client -> Web application
# Redirect: http://127.0.0.1:4173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App
# Callback: http://127.0.0.1:4173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Platform moderators. Community owners appoint their own validators in the UI.
MODERATOR_EMAILS=

# Production/Vercel: dedicated EMPTY Turso libSQL database (not a local file).
# Server-only database token. Use separate resources for Preview and Production.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local default: local. On Vercel this MUST be s3.
UPLOAD_DRIVER=local
# Private S3-compatible bucket, e.g. Supabase Storage. Never enable public access.
S3_ENDPOINT=
# Copy the exact region from the provider S3 settings (Supabase requires it).
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
